PORT=3000
SHOP_NAME=
DASHBOARD_PASSWORD=replace-with-at-least-32-random-characters

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Instagram API with Unified Login (Facebook Login for Business configuration)
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_API_VERSION=v26.0
APP_URL=https://custom-vert-zeta.vercel.app
META_REDIRECT_URI=https://custom-vert-zeta.vercel.app/auth/instagram/callback
META_TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
IG_VERIFY_TOKEN=replace-with-a-long-random-string

# Optional legacy Instagram Login fallback only; not used by Unified Login OAuth
IG_API_VERSION=
IG_ACCESS_TOKEN=
IG_APP_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
MAIL_FROM=orders@yourdomain.com
OWNER_EMAIL=

PRICE_CAR=1200
PRICE_BIKE=700

# Customer memory is stored in customer_profiles in Postgres.

# 1 = human-like delays, 0 = instant replies (for testing)
DELAY_SCALE=1
# Vercel: add a Neon Postgres store from Storage -> Marketplace; it injects DATABASE_URL automatically
DATABASE_URL=
